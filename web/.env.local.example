# ==============================================================================
# Next.js Configuration Template
# Copy this file to '.env' and fill in your actual values.
# ==============================================================================

# Supabase project URL
NEXT_PUBLIC_SUPABASE_PROJECT_URL=http://localhost:54321

# Supabase publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Base URL of the app
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Supabase secret (service role) key
SUPABASE_SECRET_KEY=your-secret-service-role-key

# Web Push (VAPID) - Created using 'npx web-push generate-vapid-keys'
# Public key (used when subscribing)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
# Private key (used when sending)
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact URI for the push services (https: or mailto:)
VAPID_SUBJECT=https://your-domain.example
